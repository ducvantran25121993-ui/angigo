rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPost(data) {
      return data.id is string && data.id.size() <= 150 &&
             data.slug is string && data.slug.size() <= 150 &&
             data.title is string && data.title.size() <= 300 &&
             data.content is string && data.content.size() <= 500000;
    }

    function isValidDeletedPost(data) {
      return data.slugOrId is string && data.slugOrId.size() <= 150;
    }

    function isValidBlogSyncManifest(data) {
      return data.keys().hasAll(['version', 'updatedAt', 'deletedSlugs', 'posts']) &&
             data.keys().hasOnly(['version', 'updatedAt', 'deletedSlugs', 'posts']) &&
             data.version is int && data.version >= 0 &&
             data.updatedAt is string && data.updatedAt.size() <= 100 &&
             data.deletedSlugs is list && data.deletedSlugs.size() <= 1000 &&
             (data.deletedSlugs.size() == 0 || data.deletedSlugs[0] is string) &&
             data.posts is list && data.posts.size() <= 500 &&
             (data.posts.size() == 0 || data.posts[0] is map);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isValidId(postId) && isValidPost(request.resource.data);
      allow update: if isValidId(postId) && isValidPost(request.resource.data);
      allow delete: if isValidId(postId);
    }

    match /deleted_posts/{slugId} {
      allow read: if true;
      allow create: if isValidId(slugId) && isValidDeletedPost(request.resource.data);
      allow update: if isValidId(slugId) && isValidDeletedPost(request.resource.data);
      allow delete: if isValidId(slugId);
    }

    match /meta/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow create: if isValidId(docId) && isValidBlogSyncManifest(request.resource.data);
      allow update: if isValidId(docId) && isValidBlogSyncManifest(request.resource.data);
      allow delete: if false;
    }

    match /test/{testId} {
      allow read: if true;
    }
  }
}

